{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system, anchored to the original Figma/Token Studio export ('tokens/' reference set): where they overlap, those values are primary and this file adapts to them, not vice versa. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.tsx (scripts/build-tokens.mjs regenerates both on every dev build). Colors are authored as hex; the generator converts light/dark color roles into 'H S% L%' channels for the web theme and keeps hex for mobile (tokens.tsx). Every color role exists in both themes. The original export is light-only: dark-theme values outside its palette are derived proposals, marked where relevant.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F9F9F9" },
      "foreground": { "$value": "#1B1B1B" },
      "border": { "$value": "#E4E3E3" },
      "separator": {
        "$value": "{color.light.primary}",
        "$description": "Separator/divider line -- inherits the theme primary so it re-tints with the live brand picker (the original system draws separators in brand color)."
      },
      "card": {
        "$value": "#F9F9F9",
        "$description": "Original palette 'white' is #F9F9F9 -- the system contains no pure white. Cards sit on the background and are separated by borders, exactly as in the original."
      },
      "cardForeground": { "$value": "#1B1B1B" },
      "popover": { "$value": "#F9F9F9" },
      "popoverForeground": { "$value": "#1B1B1B" },
      "primary": {
        "$value": "#204384",
        "$description": "Primary brand color (original custom.light). Drives buttons, links, emphasis."
      },
      "primaryForeground": { "$value": "#F9F9F9" },
      "secondary": { "$value": "#E4E3E3" },
      "secondaryForeground": { "$value": "#1B1B1B" },
      "muted": { "$value": "#E4E3E3" },
      "mutedForeground": { "$value": "#383838" },
      "accent": {
        "$value": "#CFEC14",
        "$description": "Original 'yellow' / alert, used as the highlight accent."
      },
      "accentForeground": { "$value": "#1B1B1B" },
      "destructive": {
        "$value": "#EE1F25",
        "$description": "Original 'red' / error."
      },
      "destructiveForeground": { "$value": "#F9F9F9" },
      "success": {
        "$value": "#218A38",
        "$description": "Original 'green' / ready-success."
      },
      "successForeground": { "$value": "#F9F9F9" },
      "input": { "$value": "#E4E3E3" },
      "ring": { "$value": "#204384" },
      "chart1": { "$value": "#204384" },
      "chart2": { "$value": "#218A38" },
      "chart3": { "$value": "#CFEC14" },
      "chart4": { "$value": "#EE1F25" },
      "chart5": {
        "$value": "#919191",
        "$description": "Original 'gray' -- the intermediate gray step of the shared gray family."
      },
      "white": {
        "$value": "#F9F9F9",
        "$description": "Original palette 'white' step (the system contains no pure white). Theme-fixed light anchor: ported control containers that keep their exported light value in both themes (checkbox/radio/field-disabled onContainer, pagination odd cell)."
      },
      "graySoft": {
        "$value": "#E4E3E3",
        "$description": "Original palette 'graySoft' step. Theme-fixed: glyph/knob fills riding brand colors and light control surfaces (badge labels, checkbox glyph, switch ON trigger, select container)."
      },
      "gray": {
        "$value": "#919191",
        "$description": "Original palette 'gray' step -- same value as chart5, named for the scale: disabled containers, borders and labels (switch/field/pagination)."
      },
      "blackSoft": {
        "$value": "#383838",
        "$description": "Original palette 'blackSoft' step. Theme-fixed dark ink on light fills: alert badge label, select default label, switch OFF trigger."
      },
      "sidebar": { "$value": "#F9F9F9" },
      "sidebarForeground": { "$value": "#383838" },
      "sidebarBorder": { "$value": "#E4E3E3" },
      "sidebarPrimary": { "$value": "#204384" },
      "sidebarPrimaryForeground": { "$value": "#F9F9F9" },
      "sidebarAccent": { "$value": "#CFEC14" },
      "sidebarAccentForeground": { "$value": "#1B1B1B" },
      "sidebarRing": { "$value": "#204384" }
    },
    "dark": {
      "background": { "$value": "#1B1B1B" },
      "foreground": { "$value": "#F9F9F9" },
      "border": { "$value": "#383838" },
      "separator": {
        "$value": "{color.dark.primary}",
        "$description": "Separator/divider line -- inherits the theme primary."
      },
      "card": { "$value": "#383838" },
      "cardForeground": { "$value": "#F9F9F9" },
      "popover": { "$value": "#383838" },
      "popoverForeground": { "$value": "#F9F9F9" },
      "primary": {
        "$value": "#6C8FCB",
        "$description": "Dark-theme primary: a lighter Pella blue with readable contrast on the dark surface (original export is light-only; this value stays as approved)."
      },
      "primaryForeground": { "$value": "#1B1B1B" },
      "secondary": { "$value": "#383838" },
      "secondaryForeground": { "$value": "#F9F9F9" },
      "muted": { "$value": "#383838" },
      "mutedForeground": { "$value": "#E4E3E3" },
      "accent": { "$value": "#CFEC14" },
      "accentForeground": { "$value": "#1B1B1B" },
      "destructive": { "$value": "#EE1F25" },
      "destructiveForeground": { "$value": "#F9F9F9" },
      "success": { "$value": "#5BB86B" },
      "successForeground": { "$value": "#1B1B1B" },
      "input": { "$value": "#383838" },
      "ring": { "$value": "#CFEC14" },
      "chart1": { "$value": "#6C8FCB" },
      "chart2": { "$value": "#5BB86B" },
      "chart3": { "$value": "#CFEC14" },
      "chart4": { "$value": "#FF6B6F" },
      "chart5": { "$value": "#919191" },
      "white": { "$value": "#F9F9F9", "$description": "Theme-fixed light anchor -- same role as in the light scope." },
      "graySoft": { "$value": "#E4E3E3", "$description": "Theme-fixed light anchor -- same role as in the light scope." },
      "gray": { "$value": "#919191", "$description": "Theme-fixed -- same role as in the light scope." },
      "blackSoft": { "$value": "#383838", "$description": "Theme-fixed dark ink -- same role as in the light scope." },
      "sidebar": { "$value": "#1B1B1B" },
      "sidebarForeground": { "$value": "#F9F9F9" },
      "sidebarBorder": { "$value": "#383838" },
      "sidebarPrimary": { "$value": "#6C8FCB" },
      "sidebarPrimaryForeground": { "$value": "#1B1B1B" },
      "sidebarAccent": { "$value": "#CFEC14" },
      "sidebarAccentForeground": { "$value": "#1B1B1B" },
      "sidebarRing": { "$value": "#CFEC14" }
    }
  },
  "typography": {
    "$description": "Original typography system: Roboto Light (300) only, tracking 0.25px, eight named styles. Scale names reuse the original coreDimensions keys they reference.",
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Roboto", "Arial", "sans-serif"],
        "$description": "Default UI and body typeface (original fontFamilies.roboto)."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    },
    "fontOptions": {
      "$description": "Selectable UI typefaces exposed to consuming apps via @workspace/pds/config (option 'font'). The default installation uses roboto; every option is self-hosted in typography.faces.",
      "roboto": {
        "$value": ["Roboto", "Arial", "sans-serif"],
        "$description": "Default -- the original system typeface."
      },
      "inter": { "$value": ["Inter", "Roboto", "Arial", "sans-serif"] },
      "spaceGrotesk": { "$value": ["Space Grotesk", "Roboto", "Arial", "sans-serif"] }
    },
    "faces": [
      {
        "family": "Roboto",
        "weight": 300,
        "style": "normal",
        "src": "/fonts/roboto-latin-300-normal.woff2"
      },
      {
        "family": "Inter",
        "weight": 300,
        "style": "normal",
        "src": "/fonts/inter-latin-300-normal.woff2"
      },
      {
        "family": "Inter",
        "weight": 400,
        "style": "normal",
        "src": "/fonts/inter-latin-400-normal.woff2"
      },
      {
        "family": "Inter",
        "weight": 500,
        "style": "normal",
        "src": "/fonts/inter-latin-500-normal.woff2"
      },
      {
        "family": "Space Grotesk",
        "weight": 300,
        "style": "normal",
        "src": "/fonts/space-grotesk-latin-300-normal.woff2"
      },
      {
        "family": "Space Grotesk",
        "weight": 400,
        "style": "normal",
        "src": "/fonts/space-grotesk-latin-400-normal.woff2"
      },
      {
        "family": "Space Grotesk",
        "weight": 500,
        "style": "normal",
        "src": "/fonts/space-grotesk-latin-500-normal.woff2"
      }
    ],
    "fontWeight": {
      "base": {
        "$type": "number",
        "$value": 300,
        "$description": "The original system uses a single weight -- Roboto Light (fontWeights.roboto-0)."
      }
    },
    "letterSpacing": {
      "base": {
        "$type": "dimension",
        "$value": "0.25px",
        "$description": "Original letterSpacing; the export notes px only ('it doesnt support rem yet')."
      }
    },
    "fontSizes": {
      "$type": "fontSizes",
      "s": { "$value": "0.75rem", "$description": "12px" },
      "mmmm": { "$value": "1rem", "$description": "16px" },
      "mm": { "$value": "1.5rem", "$description": "24px" },
      "llll": { "$value": "2rem", "$description": "32px" },
      "lll": { "$value": "2.5rem", "$description": "40px" },
      "xl": { "$value": "4rem", "$description": "64px" },
      "xxxl": { "$value": "6rem", "$description": "96px" }
    },
    "lineHeights": {
      "$type": "lineHeights",
      "ss": { "$value": "0.5rem", "$description": "8px" },
      "mmmm": { "$value": "1rem", "$description": "16px" },
      "mm": { "$value": "1.5rem", "$description": "24px" },
      "llll": { "$value": "2rem", "$description": "32px" },
      "lll": { "$value": "2.5rem", "$description": "40px" },
      "ll": { "$value": "3rem", "$description": "48px" },
      "xxl": { "$value": "4.5rem", "$description": "72px" },
      "xxxxl": { "$value": "7rem", "$description": "112px" }
    },
    "styles": {
      "$type": "typography",
      "h1": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "6rem", "lineHeight": "7rem", "letterSpacing": "0.25px", "paragraphSpacing": "0rem" },
        "$description": "96/112 -- display heading."
      },
      "h2": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "4rem", "lineHeight": "4.5rem", "letterSpacing": "0.25px", "paragraphSpacing": "0rem" },
        "$description": "64/72 -- section heading."
      },
      "h3": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "2.5rem", "lineHeight": "3rem", "letterSpacing": "0.25px", "paragraphSpacing": "0rem" },
        "$description": "40/48 -- sub-heading."
      },
      "subtitle1": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "2rem", "lineHeight": "2.5rem", "letterSpacing": "0.25px", "paragraphSpacing": "0.25rem" },
        "$description": "32/40 -- lead text."
      },
      "body1": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "1.5rem", "lineHeight": "2rem", "letterSpacing": "0.25px", "paragraphSpacing": "0.25rem" },
        "$description": "24/32 -- large body."
      },
      "body2": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "1rem", "lineHeight": "1.5rem", "letterSpacing": "0.25px", "paragraphSpacing": "0.25rem" },
        "$description": "16/24 -- standard body; also the label type of fields, buttons and dropdowns."
      },
      "button": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "1rem", "lineHeight": "1.5rem", "letterSpacing": "0.25px", "paragraphSpacing": "0.25rem" },
        "$description": "Metrics identical to body2; kept as its own name so button type can be overridden independently, exactly as in the original."
      },
      "caption": {
        "$value": { "fontFamily": "Roboto", "fontWeight": 300, "fontSize": "0.75rem", "lineHeight": "1rem", "letterSpacing": "0.25px", "paragraphSpacing": "0.25rem" },
        "$description": "12/16 -- captions and badge labels."
      }
    }
  },
  "dimensions": {
    "$type": "dimension",
    "$description": "Original coreDimensions scale, verbatim (values rem, px in description). Every size, spacing pair, radius and shadow offset in the original references this one scale.",
    "negative": { "$value": "-0.25rem", "$description": "-4px" },
    "zero": { "$value": "0rem", "$description": "0px" },
    "sssss": { "$value": "0.125rem", "$description": "2px" },
    "ssss": { "$value": "0.1rem", "$description": "1.6px -- the original border weight" },
    "sss": { "$value": "0.25rem", "$description": "4px" },
    "ss": { "$value": "0.5rem", "$description": "8px" },
    "s": { "$value": "0.75rem", "$description": "12px -- standard button radius" },
    "mmmm": { "$value": "1rem", "$description": "16px -- radio/checkbox size, field label scale step" },
    "mmm": { "$value": "1.25rem", "$description": "20px" },
    "mm": { "$value": "1.5rem", "$description": "24px -- button minimums / medium padding step" },
    "m": { "$value": "1.75rem", "$description": "28px" },
    "llll": { "$value": "2rem", "$description": "32px -- toggle track width" },
    "lll": { "$value": "2.5rem", "$description": "40px -- button minimums / large padding step" },
    "ll": { "$value": "3rem", "$description": "48px" },
    "l": { "$value": "3.5rem", "$description": "56px" },
    "xl": { "$value": "4rem", "$description": "64px" },
    "xxl": { "$value": "4.5rem", "$description": "72px" },
    "xxxl": { "$value": "6rem", "$description": "96px" },
    "xxxxl": { "$value": "7rem", "$description": "112px" }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step (original coreDimensions.sss)."
    },
    "presets": {
      "$description": "Original commonSet padding presets: pairs are 'vertical horizontal' unless noted.",
      "regular": { "$value": "0.5rem", "$description": "8px" },
      "regularMini": { "$value": "0.25rem", "$description": "4px -- mini button and tooltip spacing" },
      "textAndIcon": { "$value": "0 0.25rem", "$description": "0 4px" },
      "paddingLeft": { "$value": "0 0 0 0.25rem", "$description": "0 0 0 4px" },
      "ss": { "$value": "0.25rem 0.5rem", "$description": "4 8 -- small button padding pair" },
      "s": { "$value": "0.25rem 0.75rem", "$description": "4 12 -- special/specialized padding pair" },
      "mm": { "$value": "0.25rem 1rem", "$description": "4 16 -- medium button padding pair" },
      "m": { "$value": "0.75rem 0.75rem", "$description": "12 12" },
      "ll": { "$value": "0.5rem 0.75rem", "$description": "8 12 -- large button padding pair" },
      "l": { "$value": "0.5rem 1.5rem", "$description": "8 24" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius = original coreDimensions.s (12px); the theme derives sm/md/lg/xl from it."
    },
    "sm": { "$value": "0.25rem", "$description": "Original coreDimensions.sss -- fields, checkboxes, tooltips, tags." },
    "md": { "$value": "0.5rem", "$description": "Original coreDimensions.ss -- mini buttons and numbered badges." }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "$value": "0.1rem",
      "$description": "Original border weight: 1.6px (coreDimensions.ssss), solid, colored per component state."
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.32,
      "$description": "Original global disabled opacity -- the canonical 32%."
    }
  },
  "overlay": {
    "$type": "color",
    "$description": "State interaction layers implementing the original +/-32% variants in code: Figma cannot stack two fills, so the export stores pre-computed solid colors; live CSS composes them as a white or black wash at 32%, which yields exactly those values.",
    "lighter": {
      "$value": "#FFFFFF52",
      "$description": "White at 32% -- hover state (original 'brand lighter' variants)."
    },
    "darker": {
      "$value": "#00000052",
      "$description": "Black at 32% -- focus/active states (original 'brand darker' variants)."
    },
    "scrim": {
      "$value": "#000000CC",
      "$description": "Modal backdrop layer (dialog, drawer, sheet, alert-dialog): black at 80%. Theme-independent, like the state washes."
    }
  },
  "shadows": {
    "$type": "boxShadow",
    "$description": "Original shadow set, references resolved to concrete values. Colors are fixed in the export (#00000014 = 8% black; rgba .32).",
    "button": {
      "$value": { "x": "0rem", "y": "0.25rem", "blur": "0.5rem", "spread": "0rem", "color": "#00000014", "type": "dropShadow" },
      "$description": "Default button elevation: 0 4 8."
    },
    "menuLeft": {
      "$value": { "x": "-0.25rem", "y": "0rem", "blur": "0.5rem", "spread": "0rem", "color": "#00000014", "type": "dropShadow" },
      "$description": "Left-side menu edge: -4 0 8."
    },
    "menuRight": {
      "$value": { "x": "0.25rem", "y": "0rem", "blur": "0.5rem", "spread": "0rem", "color": "#00000014", "type": "dropShadow" },
      "$description": "Right-side menu edge: 4 0 8."
    },
    "dropDown": {
      "$value": { "x": "0rem", "y": "0.1rem", "blur": "0.1rem", "spread": "0rem", "color": "#00000052", "type": "dropShadow" },
      "$description": "Popup/dropdown: 0 1.6 1.6 (32% black) -- the original's own description string."
    },
    "trigger": {
      "$value": { "x": "0rem", "y": "0rem", "blur": "0rem", "spread": "0.5rem", "color": "#00000014", "type": "dropShadow" },
      "$description": "Soft 8% halo ring (toggle/trigger focus)."
    },
    "dots": {
      "$value": { "x": "0rem", "y": "0rem", "blur": "0.25rem", "spread": "0rem", "color": "#00000052", "type": "innerShadow" },
      "$description": "Inset 32% blur for dot/indicator surfaces."
    }
  }
}
