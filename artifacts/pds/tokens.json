{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F9F9F9" },
      "foreground": { "$value": "#1B1B1B" },
      "border": { "$value": "#E4E3E3" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#1B1B1B" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#1B1B1B" },
      "primary": {
        "$value": "#204384",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#E4E3E3" },
      "secondaryForeground": { "$value": "#1B1B1B" },
      "muted": { "$value": "#E4E3E3" },
      "mutedForeground": { "$value": "#383838" },
      "accent": { "$value": "#CFEC14" },
      "accentForeground": { "$value": "#1B1B1B" },
      "destructive": { "$value": "#EE1F25" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#E4E3E3" },
      "ring": { "$value": "#204384" },
      "chart1": { "$value": "#204384" },
      "chart2": { "$value": "#218A38" },
      "chart3": { "$value": "#CFEC14" },
      "chart4": { "$value": "#EE1F25" },
      "chart5": { "$value": "#919191" },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#383838" },
      "sidebarBorder": { "$value": "#E4E3E3" },
      "sidebarPrimary": { "$value": "#204384" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#CFEC14" },
      "sidebarAccentForeground": { "$value": "#1B1B1B" },
      "sidebarRing": { "$value": "#204384" }
    },
    "dark": {
      "background": { "$value": "#1B1B1B" },
      "foreground": { "$value": "#F9F9F9" },
      "border": { "$value": "#383838" },
      "card": { "$value": "#383838" },
      "cardForeground": { "$value": "#F9F9F9" },
      "popover": { "$value": "#383838" },
      "popoverForeground": { "$value": "#F9F9F9" },
      "primary": {
        "$value": "#6C8FCB",
        "$description": "Dark-theme primary: a lighter Pella blue with readable contrast on the dark surface."
      },
      "primaryForeground": { "$value": "#1B1B1B" },
      "secondary": { "$value": "#383838" },
      "secondaryForeground": { "$value": "#F9F9F9" },
      "muted": { "$value": "#383838" },
      "mutedForeground": { "$value": "#E4E3E3" },
      "accent": { "$value": "#CFEC14" },
      "accentForeground": { "$value": "#1B1B1B" },
      "destructive": { "$value": "#EE1F25" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#383838" },
      "ring": { "$value": "#CFEC14" },
      "chart1": { "$value": "#6C8FCB" },
      "chart2": { "$value": "#5BB86B" },
      "chart3": { "$value": "#CFEC14" },
      "chart4": { "$value": "#FF6B6F" },
      "chart5": { "$value": "#BDBDBD" },
      "sidebar": { "$value": "#1B1B1B" },
      "sidebarForeground": { "$value": "#F9F9F9" },
      "sidebarBorder": { "$value": "#383838" },
      "sidebarPrimary": { "$value": "#6C8FCB" },
      "sidebarPrimaryForeground": { "$value": "#1B1B1B" },
      "sidebarAccent": { "$value": "#CFEC14" },
      "sidebarAccentForeground": { "$value": "#1B1B1B" },
      "sidebarRing": { "$value": "#CFEC14" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Roboto", "Arial", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
