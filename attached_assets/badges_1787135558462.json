{
  "pella": {
    "comp": {
      "badge": {
        "simple": {
          "brand": {
            "default": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.custom.light}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "error": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.red}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "alert": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.yellow}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "ready": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.green}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "disabled": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.custom.light}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}",
                  "opacity": "{pella.sys.opacity.disabled}"
                }
              }
            }
          }
        },
        "spacing": {
          "numbered": {
            "labelSpacing": {
              "$type": "spacing",
              "$value": "{pella.sys.coreDimensions.zero} {pella.sys.coreDimensions.sss}"
            }
          }
        },
        "numbered": {
          "brand": {
            "default": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.custom.light}",
                  "borderRadius": "{pella.sys.coreDimensions.ss}",
                  "spacing": "{pella.comp.badge.spacing.numbered.labelSpacing}"
                }
              },
              "label": {
                "$type": "composition",
                "$value": {
                  "typography": "{pella.ref.typography.caption}",
                  "fill": "{pella.sys.color.graySoft}"
                }
              }
            },
            "error": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.red}",
                  "borderRadius": "{pella.sys.coreDimensions.ss}",
                  "spacing": "{pella.comp.badge.spacing.numbered.labelSpacing}"
                }
              },
              "label": {
                "$type": "composition",
                "$value": {
                  "typography": "{pella.ref.typography.caption}",
                  "fill": "{pella.sys.color.graySoft}"
                }
              }
            },
            "alert": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.yellow}",
                  "borderRadius": "{pella.sys.coreDimensions.ss}",
                  "spacing": "{pella.comp.badge.spacing.numbered.labelSpacing}"
                }
              },
              "label": {
                "$type": "composition",
                "$value": {
                  "typography": "{pella.ref.typography.caption}",
                  "fill": "{pella.sys.color.blackSoft}"
                }
              }
            },
            "ready": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.green}",
                  "borderRadius": "{pella.sys.coreDimensions.ss}",
                  "spacing": "{pella.comp.badge.spacing.numbered.labelSpacing}"
                }
              },
              "label": {
                "$type": "composition",
                "$value": {
                  "typography": "{pella.ref.typography.caption}",
                  "fill": "{pella.sys.color.graySoft}"
                }
              }
            },
            "disabled": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.custom.light}",
                  "borderRadius": "{pella.sys.coreDimensions.ss}",
                  "spacing": "{pella.comp.badge.spacing.numbered.labelSpacing}",
                  "opacity": "{pella.sys.opacity.disabled}"
                }
              },
              "label": {
                "$type": "composition",
                "$value": {
                  "typography": "{pella.ref.typography.caption}",
                  "fill": "{pella.sys.color.graySoft}"
                }
              }
            }
          }
        }
      }
    }
  }
}