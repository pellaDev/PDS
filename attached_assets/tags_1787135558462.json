{
  "pella": {
    "comp": {
      "tag": {
        "simple": {
          "brand": {
            "default": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.custom.light}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "error": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.red}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "alert": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.yellow}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "ready": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.green}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}"
                }
              }
            },
            "disabled": {
              "container": {
                "$type": "composition",
                "$value": {
                  "fill": "{pella.sys.color.custom.light}",
                  "borderRadius": "{pella.sys.coreDimensions.sss}",
                  "opacity": "{pella.sys.opacity.disabled}"
                }
              }
            }
          }
        }
      },
      "tooltip": {
        "spacing": {
          "default": {
            "$type": "spacing",
            "$value": "{pella.sys.coreDimensions.zero} {pella.sys.coreDimensions.sss}",
            "$description": "0 4"
          }
        }
      }
    }
  }
}